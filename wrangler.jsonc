
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-world-db",
      "database_id": "96520018-0ed6-4c78-af33-a53fcc1829ec"
    }
  ]
}
